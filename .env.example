# ==============================================================================
# MAATRAM SYNC: SUPABASE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env or .env.local and populate with your project credentials:
# cp .env.example .env

# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-url.supabase.co

# Your Supabase Project Anon / Public API Key
# (DO NOT expose service-role secret keys here. Anon key is safe for client applications with RLS)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
